[Unit]
Description=GPUMon daily CSV export of records older than the public history window
Documentation=file:///opt/gpumon/docs/operations.md
After=gpumon-central.service

[Service]
Type=oneshot
User=gpumon
Group=gpumon
# Writes <kind>-YYYY-MM-DD.csv files to auto_export.dir (default /var/lib/gpumon/exports).
ExecStart=/opt/gpumon/venv/bin/gpumon auto-export --config /etc/gpumon/central.yaml
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/gpumon
PrivateTmp=yes
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0027
