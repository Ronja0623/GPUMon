{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GPUMon agent-to-central payload",
  "description": "One message posted by gpumon-agent to POST /api/v1/ingest. schema_version 1.",
  "oneOf": [
    {"$ref": "#/definitions/sample"},
    {"$ref": "#/definitions/inventory"},
    {"$ref": "#/definitions/disk_scan"}
  ],
  "definitions": {
    "schema_version": {"const": 1},
    "server_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "agent_version": {"type": "string", "maxLength": 64},
    "uint": {"type": "integer", "minimum": 0},
    "nullable_uint": {"type": ["integer", "null"], "minimum": 0},
    "nullable_number": {"type": ["number", "null"], "minimum": 0},
    "errors": {"type": "array", "items": {"type": "string", "maxLength": 1000}, "maxItems": 200},
    "owner": {"type": "string", "minLength": 1, "maxLength": 128},
    "attribution": {
      "type": "string",
      "enum": ["uid", "loginuid", "subuid", "docker_label", "docker_default_owner",
               "multipass_name", "system", "root_shared", "unattributed"]
    },
    "name": {"type": "string", "maxLength": 256},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_percent", "logical_cores", "load_avg", "mem_total_bytes", "mem_used_bytes",
                   "mem_available_bytes", "swap_total_bytes", "swap_used_bytes"],
      "properties": {
        "cpu_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "logical_cores": {"$ref": "#/definitions/uint"},
        "load_avg": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 3, "maxItems": 3},
        "mem_total_bytes": {"$ref": "#/definitions/uint"},
        "mem_used_bytes": {"$ref": "#/definitions/uint"},
        "mem_available_bytes": {"$ref": "#/definitions/uint"},
        "swap_total_bytes": {"$ref": "#/definitions/uint"},
        "swap_used_bytes": {"$ref": "#/definitions/uint"}
      }
    },
    "gpu_process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "type", "vram_mib", "exe", "owner", "attribution"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "type": {"type": "string", "enum": ["compute", "graphics"]},
        "vram_mib": {"$ref": "#/definitions/nullable_uint"},
        "utilization_pct": {"type": "integer", "minimum": 0, "maximum": 100},
        "exe": {"$ref": "#/definitions/name"},
        "owner": {"$ref": "#/definitions/owner"},
        "attribution": {"$ref": "#/definitions/attribution"},
        "container_id": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
        "container_name": {"$ref": "#/definitions/name"},
        "container_image": {"$ref": "#/definitions/name"},
        "vm_name": {"$ref": "#/definitions/name"},
        "account": {"$ref": "#/definitions/name"}
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "uuid", "name", "vram_total_mib", "vram_used_mib", "utilization_pct",
                   "temperature_c", "power_draw_w", "power_limit_w", "fan_pct", "processes"],
      "properties": {
        "index": {"$ref": "#/definitions/uint"},
        "uuid": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": ["string", "null"], "maxLength": 256},
        "vram_total_mib": {"$ref": "#/definitions/nullable_uint"},
        "vram_used_mib": {"$ref": "#/definitions/nullable_uint"},
        "utilization_pct": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "temperature_c": {"$ref": "#/definitions/nullable_uint"},
        "power_draw_w": {"$ref": "#/definitions/nullable_number"},
        "power_limit_w": {"$ref": "#/definitions/nullable_number"},
        "fan_pct": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "processes": {"type": "array", "items": {"$ref": "#/definitions/gpu_process"}}
      }
    },
    "top_process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "exe", "cpu_cores", "rss_bytes"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "exe": {"$ref": "#/definitions/name"},
        "cpu_cores": {"type": "number", "minimum": 0},
        "rss_bytes": {"$ref": "#/definitions/uint"},
        "container_name": {"$ref": "#/definitions/name"},
        "vm_name": {"$ref": "#/definitions/name"}
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "attributions", "cpu_cores", "rss_bytes", "process_count", "top_cpu", "top_rss"],
      "properties": {
        "owner": {"$ref": "#/definitions/owner"},
        "attributions": {"type": "array", "items": {"$ref": "#/definitions/attribution"}, "minItems": 1, "uniqueItems": true},
        "cpu_cores": {"type": "number", "minimum": 0},
        "rss_bytes": {"$ref": "#/definitions/uint"},
        "process_count": {"type": "integer", "minimum": 1},
        "top_cpu": {"type": "array", "items": {"$ref": "#/definitions/top_process"}, "maxItems": 100},
        "top_rss": {"type": "array", "items": {"$ref": "#/definitions/top_process"}, "maxItems": 100}
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mount", "size_bytes", "used_bytes", "free_bytes"],
      "properties": {
        "mount": {"type": "string", "pattern": "^/"},
        "size_bytes": {"$ref": "#/definitions/uint"},
        "used_bytes": {"$ref": "#/definitions/uint"},
        "free_bytes": {"$ref": "#/definitions/uint"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "server_id", "run_id", "timestamp", "agent_version", "seq",
                   "interval_seconds", "host", "gpus", "users", "filesystems", "errors"],
      "properties": {
        "schema_version": {"$ref": "#/definitions/schema_version"},
        "type": {"const": "sample"},
        "server_id": {"$ref": "#/definitions/server_id"},
        "run_id": {"$ref": "#/definitions/run_id"},
        "timestamp": {"$ref": "#/definitions/timestamp"},
        "agent_version": {"$ref": "#/definitions/agent_version"},
        "seq": {"type": "integer", "minimum": 1},
        "interval_seconds": {"type": "number", "exclusiveMinimum": 0},
        "host": {"$ref": "#/definitions/host"},
        "gpus": {"type": "array", "items": {"$ref": "#/definitions/gpu"}, "maxItems": 64},
        "users": {"type": "array", "items": {"$ref": "#/definitions/user"}},
        "filesystems": {"type": "array", "items": {"$ref": "#/definitions/filesystem"}},
        "errors": {"$ref": "#/definitions/errors"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "server_id", "run_id", "timestamp", "agent_version", "inventory", "errors"],
      "properties": {
        "schema_version": {"$ref": "#/definitions/schema_version"},
        "type": {"const": "inventory"},
        "server_id": {"$ref": "#/definitions/server_id"},
        "run_id": {"$ref": "#/definitions/run_id"},
        "timestamp": {"$ref": "#/definitions/timestamp"},
        "agent_version": {"$ref": "#/definitions/agent_version"},
        "errors": {"$ref": "#/definitions/errors"},
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "os_release", "kernel", "cpu_model", "logical_cores", "mem_total_bytes",
                       "driver_version", "cuda_driver_version", "gpus", "filesystems"],
          "properties": {
            "hostname": {"$ref": "#/definitions/name"},
            "os_release": {"$ref": "#/definitions/name"},
            "kernel": {"$ref": "#/definitions/name"},
            "cpu_model": {"$ref": "#/definitions/name"},
            "logical_cores": {"$ref": "#/definitions/uint"},
            "mem_total_bytes": {"$ref": "#/definitions/uint"},
            "driver_version": {"type": ["string", "null"], "maxLength": 64},
            "cuda_driver_version": {"type": ["string", "null"], "maxLength": 64},
            "gpus": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "uuid", "name", "vram_total_mib"],
                "properties": {
                  "index": {"$ref": "#/definitions/uint"},
                  "uuid": {"type": "string", "minLength": 1, "maxLength": 128},
                  "name": {"type": ["string", "null"], "maxLength": 256},
                  "vram_total_mib": {"$ref": "#/definitions/nullable_uint"}
                }
              }
            },
            "filesystems": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mount", "size_bytes"],
                "properties": {
                  "mount": {"type": "string", "pattern": "^/"},
                  "size_bytes": {"$ref": "#/definitions/uint"}
                }
              }
            }
          }
        }
      }
    },
    "disk_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "server_id", "run_id", "timestamp", "agent_version", "scan", "errors"],
      "properties": {
        "schema_version": {"$ref": "#/definitions/schema_version"},
        "type": {"const": "disk_scan"},
        "server_id": {"$ref": "#/definitions/server_id"},
        "run_id": {"$ref": "#/definitions/run_id"},
        "timestamp": {"$ref": "#/definitions/timestamp"},
        "agent_version": {"$ref": "#/definitions/agent_version"},
        "errors": {"$ref": "#/definitions/errors"},
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "completed_at", "partial", "paths"],
          "properties": {
            "started_at": {"$ref": "#/definitions/timestamp"},
            "completed_at": {"$ref": "#/definitions/timestamp"},
            "partial": {"type": "boolean"},
            "paths": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "mount", "total_bytes", "partial", "owners"],
                "properties": {
                  "path": {"type": "string", "pattern": "^/"},
                  "mount": {"type": "string", "pattern": "^/"},
                  "total_bytes": {"$ref": "#/definitions/uint"},
                  "partial": {"type": "boolean"},
                  "owners": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["owner", "bytes"],
                      "properties": {
                        "owner": {"$ref": "#/definitions/owner"},
                        "bytes": {"$ref": "#/definitions/uint"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
